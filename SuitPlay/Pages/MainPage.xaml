<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SuitPlay.Views"
             x:Class="SuitPlay.Pages.MainPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WidthRequest" Value="110"/>
            <Setter Property="HeightRequest" Value="75"/>
            <Setter Property="ContentLayout" Value="Bottom, 10"/>
        </Style>
        <Style TargetType="Label" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#C9804F"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,auto">
        <ScrollView Grid.Row="0" x:Name="MainScroll">
            <VerticalStackLayout
                Padding="20,10,20,20"
                Spacing="12">

                <!-- En-tête -->
                <VerticalStackLayout>
                    <Label Text="SuitPlay" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Meilleur maniement d'une couleur au bridge" FontSize="12" TextColor="#ACACAC"/>
                </VerticalStackLayout>

                <Label Text="Touchez une main (Nord ou Sud) pour la sélectionner, puis touchez les cartes à lui donner. Touchez une carte d'une main pour la remettre dans le paquet."
                       FontSize="12" TextColor="#ACACAC" LineBreakMode="WordWrap"/>

                <Label Text="Cartes disponibles" Style="{StaticResource SectionTitle}"/>
                <Border>
                    <views:HandView x:Name="Cards" Padding="10"/>
                </Border>
                <Label Text="Nord" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                <Border>
                    <views:HandView x:Name="North" Padding="10"/>
                </Border>
                <Label Text="Sud" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                <Border>
                    <views:HandView x:Name="South" Padding="10"/>
                </Border>
                <Label Text="Défausses ou coupes (cartes de Nord-Sud qui ne seront pas jouées dans la couleur)" HorizontalOptions="Center" FontSize="12" TextColor="#ACACAC"/>
                <Border StrokeDashArray="4,3">
                    <views:HandView x:Name="Discards" Padding="10"/>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center">
                    <Button Text="Tout effacer" Clicked="ResetButton_OnClicked" Margin="20,10"/>
                    <Button Text="Calculer" x:Name="CalculateButton" Clicked="CalculateButton_OnClicked" Margin="20,10"/>
                </HorizontalStackLayout>

                <Label x:Name="StatusLabel" Text="Choisissez les cartes de Nord et de Sud, puis cliquez sur « Calculer »."
                       LineBreakMode="WordWrap"/>

                <!-- Résultats -->
                <VerticalStackLayout x:Name="ResultsPanel" IsVisible="False" Spacing="8">
                    <Label Text="Chances de réussite selon l'objectif" Style="{StaticResource SectionTitle}"/>
                    <Grid x:Name="ResultsGrid" ColumnDefinitions="auto,auto,*" ColumnSpacing="20" RowSpacing="4"/>

                    <Label Text="Ligne de jeu conseillée" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Objectif :" VerticalOptions="Center"/>
                        <Picker x:Name="GoalPicker" WidthRequest="280" SelectedIndexChanged="GoalPicker_OnSelectedIndexChanged"/>
                    </HorizontalStackLayout>
                    <Label x:Name="GoalSummary" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                    <Label x:Name="LineDescription" LineBreakMode="WordWrap"/>
                    <Label x:Name="VariantsTitle" Text="Si la défense ne fournit pas petit" FontAttributes="Bold" IsVisible="False" Margin="0,6,0,0"/>
                    <Label x:Name="VariantsText" LineBreakMode="WordWrap" IsVisible="False"/>
                    <Label x:Name="LineSequence" FontSize="12" TextColor="#ACACAC" LineBreakMode="WordWrap"/>
                    <Button x:Name="PlaysButton" Text="Voir le déroulement pour chaque répartition adverse" Clicked="PlaysButton_OnClicked"
                            HorizontalOptions="Start" Margin="0,8,0,0"/>
                    <Label x:Name="PlaysText" LineBreakMode="WordWrap" IsVisible="False" FontSize="13"/>
                    <Label Text="La ligne décrite suppose que les adversaires fournissent petit ; le déroulement ci-dessus montre chaque répartition, cartes réelles, avec la défense la plus gênante."
                           FontSize="11" TextColor="#ACACAC" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <HorizontalStackLayout Grid.Row="1">
            <Button Text="Réglages" ImageSource="icons8_settings_32.png"
                    Clicked="SettingsButton_OnClicked" Style="{StaticResource ToolbarButton}"/>
            <Button x:Name="DistributionsButton" Text="Répartitions" ImageSource="icons8_normal_distribution_histogram_32.png"
                    Clicked="DistributionsButton_OnClicked" Style="{StaticResource ToolbarButton}"
                    IsEnabled="False"/>
            <Button Text="Options" ImageSource="icons8_filter_32.png"
                    Clicked="OtherFactorsButton_OnClicked" Style="{StaticResource ToolbarButton}"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
