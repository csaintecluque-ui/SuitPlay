@* SuitPlay — version web (PWA) : même moteur de calcul que la version Windows *@

<div class="app">
    <header class="top">
        <h1>SuitPlay</h1>
        <p>Meilleur maniement d'une couleur au bridge</p>
    </header>

    <section class="panel">
        <h2>Les cartes de la couleur</h2>
        <p class="hint">Choisissez la main, puis touchez les cartes à lui donner. Touchez à nouveau une carte pour la retirer.</p>

        <div class="seg">
            <button class="@(currentHand == 'N' ? "on-n" : "")" @onclick="@(() => currentHand = 'N')">Donner à Nord</button>
            <button class="@(currentHand == 'S' ? "on-s" : "")" @onclick="@(() => currentHand = 'S')">Donner à Sud</button>
        </div>

        <div class="cards">
            @foreach (var face in AllFaces)
            {
                var owner = Owner(face);
                <button class="card @(owner == 'N' ? "n" : owner == 'S' ? "s" : "")" @onclick="@(() => Toggle(face))"
                        aria-label="@FrenchText.CardName(face)">
                    @FrenchText.ShortName(face)
                    @if (owner != null)
                    {
                        <span class="tag">@(owner == 'N' ? "NORD" : "SUD")</span>
                    }
                </button>
            }
        </div>

        <div class="hands">
            <div class="hand n"><b>Nord</b><span>@HandText('N')</span></div>
            <div class="hand s"><b>Sud</b><span>@HandText('S')</span></div>
        </div>

        <details class="options">
            <summary>Options avancées</summary>
            <div class="opt-row">
                <input id="vacant" type="checkbox" @bind="useVacantPlaces" />
                <label for="vacant">Tenir compte des places vacantes</label>
            </div>
            @if (useVacantPlaces)
            {
                <p class="hint">Nombre de cartes inconnues dans chaque main adverse (13 au départ, moins les cartes déjà connues, par exemple une longue couleur annoncée).</p>
                <div class="opt-row">
                    <label for="vw">Ouest</label>
                    <input id="vw" type="number" min="0" max="13" @bind="vacantWest" />
                    <label for="ve">Est</label>
                    <input id="ve" type="number" min="0" max="13" @bind="vacantEast" />
                </div>
            }
            <div class="opt-row">
                <input id="entries" type="checkbox" @bind="useEntries" />
                <label for="entries">Limiter les entrées au mort (Nord)</label>
            </div>
            @if (useEntries)
            {
                <div class="opt-row">
                    <label for="en">Nombre d'entrées en Nord</label>
                    <input id="en" type="number" min="0" max="13" @bind="entriesNorth" />
                </div>
                <p class="hint">Jouer la couleur depuis Nord coûte une entrée, sauf si Nord vient de remporter la levée précédente dans la couleur.</p>
            }
            <div class="opt-row">
                <input id="imp" type="checkbox" @bind="useImp" />
                <label for="imp">Mode IMP : tenir compte du contrat (équipes)</label>
            </div>
            @if (useImp)
            {
                <div class="opt-row">
                    <label for="lvl">Contrat</label>
                    <select id="lvl" @bind="impLevel">
                        @for (var l = 1; l <= 7; l++) { <option value="@l">@l</option> }
                    </select>
                    <select id="strain" @bind="impStrain">
                        <option value="@Strain.Clubs">♣</option>
                        <option value="@Strain.Diamonds">♦</option>
                        <option value="@Strain.Hearts">♥</option>
                        <option value="@Strain.Spades">♠</option>
                        <option value="@Strain.NoTrump">SA</option>
                    </select>
                    <select id="dbl" @bind="impDoubled">
                        <option value="0">non contré</option>
                        <option value="1">contré</option>
                        <option value="2">surcontré</option>
                    </select>
                </div>
                <div class="opt-row">
                    <input id="vul" type="checkbox" @bind="impVulnerable" />
                    <label for="vul">Vulnérable</label>
                </div>
                <div class="opt-row">
                    <label for="need">Levées nécessaires dans cette couleur pour réussir le contrat</label>
                    <input id="need" type="number" min="0" max="13" @bind="impTricksNeeded" />
                </div>
            }
            <div class="opt-row">
                <input id="false" type="checkbox" @bind="useFalsecards" />
                <label for="false">Les adversaires peuvent fournir de fausses cartes</label>
            </div>
        </details>

        <div class="actions">
            <button class="btn" @onclick="Reset">Effacer</button>
            <button class="btn primary" @onclick="CalculateAsync" disabled="@(busy || CardsOf('N').Length + CardsOf('S').Length == 0)">
                @(busy ? "Calcul en cours…" : "Calculer")
            </button>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(status))
    {
        <p class="status @(isError ? "error" : "")">@status</p>
    }

    @if (result != null && !busy)
    {
        <section class="panel" id="resultats">
            <h2>Chances de réussite selon l'objectif</h2>
            <table class="goals">
                <thead><tr><th>Objectif</th><th>Chances</th><th>1re carte</th></tr></thead>
                <tbody>
                    <tr class="impossible"><td>@(maxTricks + 1) levées ou plus</td><td class="pct">impossible</td><td></td></tr>
                    @foreach (var goal in goalTricks)
                    {
                        var line = BestLineFor(goal);
                        <tr>
                            <td>Au moins @goal levée@(goal > 1 ? "s" : "")</td>
                            <td class="pct">@(goal <= guaranteedTricks ? "100 % (assuré)" : Pct(ProbabilityFor(line, goal)) + " %")</td>
                            <td class="first">@FirstCard(line)</td>
                        </tr>
                    }
                    <tr>
                        <td>Maximum de levées</td>
                        <td class="pct">@Num(AverageOf(BestLineFor(null)), "0.00") en moy.</td>
                        <td class="first">@FirstCard(BestLineFor(null))</td>
                    </tr>
                    <tr>
                        <td>Matchpoints</td>
                        <td class="pct">meilleure en face à face</td>
                        <td class="first">@FirstCard(BestLineFor(MatchpointGoal))</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="panel">
            <h2>Ligne de jeu conseillée</h2>
            <select class="goal" @bind="selectedGoalIndex">
                @for (var i = 0; i < goalOptions.Count; i++)
                {
                    <option value="@i">@GoalLabel(goalOptions[i])</option>
                }
            </select>

            @{
                var selectedGoal = SelectedGoal;
                var selectedLine = BestLineFor(selectedGoal);
            }
            @if (selectedLine != null)
            {
                <p class="summary">@SummaryText(selectedGoal, selectedLine)</p>
                <ol class="steps">
                    @foreach (var step in Steps(selectedLine))
                    {
                        <li>@step</li>
                    }
                </ol>
                var variants = FrenchText.DescribeVariants(selectedLine, result);
                @if (variants.Count > 0)
                {
                    <h3 class="sub">Si la défense ne fournit pas petit</h3>
                    <ul class="variants">
                        @foreach (var variant in variants)
                        {
                            <li>@variant</li>
                        }
                    </ul>
                }
                <p class="seq">Séquence (x = petite carte) : @FrenchText.SequenceToString(selectedLine.LongestLineIncludingGenerated)</p>
                <p class="note">La ligne décrite suppose que les adversaires fournissent petit et que vous pouvez reprendre la main dans la bonne main quand il le faut.</p>

                <details class="dist">
                    <summary>Détail par répartition adverse</summary>
                    <table class="distt">
                        <thead><tr><th>Ouest</th><th>Est</th><th class="num">Proba.</th><th class="num">Levées</th></tr></thead>
                        <tbody>
                            @foreach (var row in DistributionRows(selectedLine))
                            {
                                var target = selectedGoal is > 0 ? selectedGoal.Value : selectedGoal == ImpGoal ? Contract.TricksNeeded : 0;
                                <tr>
                                    <td>@row.West</td>
                                    <td>@row.East</td>
                                    <td class="num">@Pct(row.Probability) %</td>
                                    <td class="num @(target == 0 ? "" : row.Tricks >= target ? "ok" : "ko")">@row.Tricks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </section>
    }

    <p class="foot">Moteur de calcul : projet SuitPlay de Yke Smit · usage familial</p>
</div>

@code {
    private static readonly Face[] AllFaces =
    [
        Face.Ace, Face.King, Face.Queen, Face.Jack, Face.Ten, Face.Nine, Face.Eight,
        Face.Seven, Face.Six, Face.Five, Face.Four, Face.Three, Face.Two
    ];

    private readonly Dictionary<Face, char> owners = new();
    private char currentHand = 'N';

    private bool useVacantPlaces;
    private int vacantWest = 13;
    private int vacantEast = 13;
    private bool useFalsecards;
    private bool useEntries;
    private bool useImp;
    private int impLevel = 4;
    private Strain impStrain = Strain.Spades;
    private int impDoubled;
    private bool impVulnerable;
    private int impTricksNeeded = 3;
    private const int ImpGoal = -2;

    private ImpContract Contract => new()
    {
        Level = Math.Clamp(impLevel, 1, 7), Strain = impStrain, Doubled = Math.Clamp(impDoubled, 0, 2),
        Vulnerable = impVulnerable, TricksNeeded = Math.Clamp(impTricksNeeded, 0, 13)
    };

    private string ContractText()
    {
        var c = Contract;
        var strain = c.Strain switch { Strain.Clubs => "♣", Strain.Diamonds => "♦", Strain.Hearts => "♥", Strain.Spades => "♠", _ => "SA" };
        var dbl = c.Doubled switch { 1 => " contré", 2 => " surcontré", _ => "" };
        return $"{c.Level}{strain}{dbl}{(c.Vulnerable ? " vulnérable" : "")}";
    }
    private int entriesNorth = 1;

    private bool busy;
    private string status;
    private bool isError;

    private Result2 result;
    private SuitAnalysis analysis;
    private IDictionary<Face[], List<Item>> bestPlay;
    private const int MatchpointGoal = -1;
    private int guaranteedTricks;
    private int maxTricks;
    private List<int> goalTricks = [];
    private List<int?> goalOptions = [];
    private int selectedGoalIndex;

    private int? SelectedGoal =>
        selectedGoalIndex >= 0 && selectedGoalIndex < goalOptions.Count ? goalOptions[selectedGoalIndex] : null;

    private char? Owner(Face face) => owners.TryGetValue(face, out var owner) ? owner : null;

    private void Toggle(Face face)
    {
        if (owners.TryGetValue(face, out var owner) && owner == currentHand)
            owners.Remove(face);
        else
            owners[face] = currentHand;
        ClearResult();
    }

    private Face[] CardsOf(char hand) =>
        owners.Where(x => x.Value == hand).Select(x => x.Key).OrderDescending().ToArray();

    private string HandText(char hand)
    {
        var cards = CardsOf(hand);
        return cards.Length == 0 ? "—" : string.Join(" ", cards.Select(FrenchText.ShortName));
    }

    private void Reset()
    {
        owners.Clear();
        currentHand = 'N';
        ClearResult();
    }

    private void ClearResult()
    {
        result = null;
        status = null;
        isError = false;
    }

    private async Task CalculateAsync()
    {
        var north = CardsOf('N');
        var south = CardsOf('S');
        busy = true;
        isError = false;
        status = "Calcul en cours…";
        StateHasChanged();
        await Task.Delay(40); // laisse le navigateur afficher « Calcul en cours »

        try
        {
            var watch = System.Diagnostics.Stopwatch.StartNew();
            var miniMaxSettings = new MiniMax.MiniMaxSettings
            {
                UseFalsecards = useFalsecards,
                EntriesNorth = useEntries ? Math.Clamp(entriesNorth, 0, 13) : null
            };
            bestPlay = Calculate.CalculateBestPlay(north, south, miniMaxSettings);
            var settings = new Calculate.CalculateSettings { EtalonsDirectory = "/etalons", MaxLines = 10000 };
            if (useVacantPlaces)
            {
                settings.VacantPlacesWest = Math.Clamp(vacantWest, 0, 13);
                settings.VacantPlacesEast = Math.Clamp(vacantEast, 0, 13);
            }
            result = Calculate.GetResult2(bestPlay, north, south, settings);
            analysis = SuitAnalysis.Analyse(result, settings: miniMaxSettings);
            PrepareGoals();
            var entriesText = miniMaxSettings.EntriesNorth is { } entries ? $"   ·   entrées au mort : {entries}" : "";
            status = $"Nord : {HandText('N')}   ·   Sud : {HandText('S')}{entriesText}   ·   calcul en {Num(watch.Elapsed.TotalSeconds, "0.0")} s";
        }
        catch (MaxLinesException)
        {
            result = null;
            isError = true;
            status = "Trop de lignes de jeu à examiner : simplifiez la combinaison.";
        }
        catch (Exception ex)
        {
            result = null;
            isError = true;
            status = "Le calcul a échoué : " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void PrepareGoals()
    {
        if (result?.LineItems == null || result.LineItems.Count == 0)
        {
            result = null;
            isError = true;
            status = "Aucune ligne de jeu trouvée pour cette combinaison.";
            return;
        }

        guaranteedTricks = analysis.GuaranteedTricks;
        maxTricks = analysis.MaxTricks;
        goalTricks = analysis.Goals.Where(g => g > 0).ToList();

        goalOptions = goalTricks.Select(x => (int?)x).ToList();
        goalOptions.Add(null);
        goalOptions.Add(MatchpointGoal);
        if (useImp)
        {
            goalOptions.Insert(0, ImpGoal);
        }
        selectedGoalIndex = 0;
    }

    private LineItem BestLineFor(int? goal) =>
        goal == ImpGoal ? analysis.ImpBest(Contract).Line
        : goal == MatchpointGoal ? analysis.MatchpointBest
        : goal == null || goal <= guaranteedTricks ? analysis.BestAverage().Line
        : analysis.BestFor(goal.Value).Line;

    private double ProbabilityFor(LineItem line, int goal) =>
        goal <= guaranteedTricks ? 1.0 : LineComparison.ProbabilityAtLeast(analysis.OutcomesOf(line), goal);

    private double AverageOf(LineItem line) => LineComparison.Average(analysis.OutcomesOf(line));

    private static string GoalLabel(int? goal) =>
        goal == ImpGoal ? "Meilleure ligne en IMP (selon le contrat)"
        : goal == MatchpointGoal ? "Meilleure ligne en matchpoints"
        : goal == null ? "Faire le maximum de levées (moyenne)"
        : $"Faire au moins {goal} levée{(goal > 1 ? "s" : "")}";

    private string SummaryText(int? goal, LineItem line)
    {
        if (goal == ImpGoal)
        {
            var contract = Contract;
            var (_, worst) = analysis.ImpBest(contract);
            var make = LineComparison.ProbabilityAtLeast(analysis.OutcomesOf(line), contract.TricksNeeded);
            return $"En IMP ({ContractText()}, {contract.TricksNeeded} levée{(contract.TricksNeeded > 1 ? "s" : "")} nécessaire{(contract.TricksNeeded > 1 ? "s" : "")} dans la couleur) : "
                 + $"contrat réussi dans {Pct(make)} % des cas, marque moyenne {Num(analysis.ExpectedScore(line, contract), "0")} points. "
                 + (worst >= 0 ? $"Face à chaque autre ligne, elle gagne en moyenne au moins {Num(worst, "0.00")} IMP." : $"C'est la ligne au meilleur bilan en IMP face aux autres.");
        }
        if (goal == MatchpointGoal)
        {
            var (wins, losses) = analysis.MatchpointRecord(line);
            return $"En matchpoints, cette ligne ne perd contre aucune autre en face à face (elle les bat en moyenne {Pct(wins)} % du temps, perd {Pct(losses)} %). Elle rapporte {Num(AverageOf(line), "0.00")} levées en moyenne.";
        }
        if (goal == null)
            return $"Cette ligne rapporte en moyenne {Num(AverageOf(line), "0.00")} levées.";
        if (goal <= guaranteedTricks)
            return $"{goal} levée{(goal > 1 ? "s" : "")} assurée{(goal > 1 ? "s" : "")} quelle que soit la répartition.";
        return $"Cette ligne réussit dans {Pct(ProbabilityFor(line, goal.Value))} % des cas.";
    }

    private IEnumerable<string> Steps(LineItem line)
    {
        var text = FrenchText.DescribeLine(line.LongestLineIncludingGenerated, result.North, result.South);
        foreach (var raw in text.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var sentence = raw.Trim();
            var dot = sentence.IndexOf(". ", StringComparison.Ordinal);
            yield return dot > 0 && dot <= 3 ? sentence[(dot + 2)..] : sentence;
        }
    }

    private string FirstCard(LineItem line)
    {
        var sequence = line?.LongestLineIncludingGenerated;
        if (sequence == null || sequence.Count() == 0)
            return "";
        var first = sequence.First();
        var hand = result.North.Contains(first) ? "Nord" : "Sud";
        return $"{FrenchText.ShortName(first)} de {hand}";
    }

    private record DistributionRow(string West, string East, double Probability, int Tricks);

    private List<DistributionRow> DistributionRows(LineItem line)
    {
        var cardsNS = result.North.Concat(result.South).OrderDescending().ToArray();
        var cardsEW = Utils.GetAllCards().Except(cardsNS).ToArray();
        return analysis.OutcomesOf(line)
            .Select(o =>
            {
                var east = Utils.StringToCardArray(o.Key);
                var west = cardsEW.Except(east).ToArray();
                return (West: Show(west.ConvertToSmallCards(cardsNS)), East: Show(east.ConvertToSmallCards(cardsNS)), o.Value.Probability, o.Value.Tricks);
            })
            .GroupBy(r => (r.West, r.East, r.Tricks))
            .Select(g => new DistributionRow(g.Key.West, g.Key.East, g.Sum(r => r.Probability), g.Key.Tricks))
            .OrderByDescending(r => r.Probability)
            .ToList();
    }

    private static string Show(Face[] cards) =>
        cards.Length == 0 ? "—" : string.Join(" ", cards.OrderDescending().Select(FrenchText.ShortName));

    private static string Pct(double value) => Num(value * 100, "0.0");

    private static string Num(double value, string format) =>
        value.ToString(format, CultureInfo.InvariantCulture).Replace('.', ',');
}
